---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import {
  MN_CODE_GUIDES,
  MN_TIMELINE_ROWS,
  MN_GUIDE_CITIES,
  MN_GUIDES_AUTHOR,
  MN_GUIDES_LAST_UPDATED,
  type MnTimelineRow,
} from '../../../data/mnCodeGuides';

const title = 'Minnesota Building Code Timeline for Homebuyers';
const description =
  'When each Minnesota building code requirement took effect, what it means for a home built before that date, and what is worth checking — sourced to published Minnesota law.';

const updatedLabel = new Date(`${MN_GUIDES_LAST_UPDATED}T12:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const SYSTEM_ORDER = ['Electrical', 'Structural', 'Plumbing', 'Roofing', 'HVAC'] as const;
const grouped = SYSTEM_ORDER.map((system) => ({
  system,
  rows: MN_TIMELINE_ROWS.filter((r: MnTimelineRow) => r.system === system),
})).filter((g) => g.rows.length > 0);

const faqs = [
  {
    q: 'Does Minnesota building code apply the same way in every city?',
    a: 'Largely, yes. Minnesota administers a uniform statewide building code, so the requirements on this page are state law rather than city ordinance and apply the same way in Minneapolis, Minnetonka, Edina, Eden Prairie, St. Louis Park and Maple Grove. The exceptions worth knowing are point-of-sale programs — sewer lateral inspections and septic compliance requirements are set locally and differ from one city or county to the next.',
  },
  {
    q: 'Does a home built before one of these requirements violate code?',
    a: 'No. Building code changes are prospective — they apply to work done after the change takes effect, not retroactively to homes already standing. A home built before a given standard is grandfathered and is not out of compliance with anything. The reason the date still matters is practical rather than legal: it tells you what the home was and was not built with, which is what you are actually trying to learn before you buy.',
  },
  {
    q: 'Which Minnesota code requirement is most expensive to address?',
    a: 'Of the factors on this page, stucco and EIFS moisture issues carry the widest and highest range, at roughly $15,000 to $60,000 where remediation is needed, followed by septic replacement at $3,000 to $40,000 depending on system type. At the other end, carbon monoxide alarms cost $30 to $100 each and can be resolved the week you move in.',
  },
  {
    q: 'Does Minnesota require a septic inspection when a home is sold?',
    a: 'Not as a matter of state law. Minn. Stat. 115.55 subd. 6 requires the seller to disclose the system and what they know about its compliance status at transfer. Whether a compliance inspection is required, and when, is set by county or city ordinance and varies. Lenders frequently want a compliance certificate before closing regardless, so it is worth checking with the county early.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: {
    '@type': 'Person',
    name: MN_GUIDES_AUTHOR.name,
    jobTitle: MN_GUIDES_AUTHOR.role,
  },
  publisher: { '@type': 'Organization', name: 'Tarn' },
  dateModified: MN_GUIDES_LAST_UPDATED,
  isAccessibleForFree: true,
};
---

<Layout title={`${title} | Tarn`} description={description}>
  <Header slot="header" />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />

  <section class="mn-hero">
    <div class="wrap">
      <p class="eyebrow">Minnesota reference</p>
      <h1>{title}</h1>
      <p class="hero-lede">
        Minnesota runs a uniform statewide building code, which means the year a requirement took
        effect tells you something specific about any home in the state built before it. This is
        every code-era factor Tarn checks on a Minnesota address, when each one took effect, and
        what it means for a home that predates it.
      </p>
      <p class="hero-byline">
        By {MN_GUIDES_AUTHOR.name}, {MN_GUIDES_AUTHOR.role} · Updated{' '}
        <time datetime={MN_GUIDES_LAST_UPDATED}>{updatedLabel}</time>
      </p>
    </div>
  </section>

  <section class="mn-intro">
    <div class="wrap">
      <p>
        One thing to be clear about before the table: none of this describes a home breaking a rule.
        Code changes apply going forward, not backward, so a house built in 1968 was built to the
        1968 standard and stays grandfathered. The dates matter because they tell you what the home
        was built with — and what a later owner may or may not have updated since.
      </p>
    </div>
  </section>

  <section class="timeline">
    <div class="wrap">
      {grouped.map((group) => (
        <div class="system-block">
          <h2>{group.system}</h2>
          <table class="timeline-table">
            <thead>
              <tr>
                <th scope="col">Requirement</th>
                <th scope="col">Took effect</th>
                <th scope="col">Applies to</th>
              </tr>
            </thead>
            <tbody>
              {group.rows.map((r) => (
                <tr>
                  <td>
                    <a href={r.href}>{r.requirement}</a>
                    {r.national && <span class="tag">National guide</span>}
                  </td>
                  <td>{r.effective}</td>
                  <td>{r.appliesTo}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>
  </section>

  <section class="mn-guides">
    <div class="wrap">
      <h2>Minnesota-specific guides</h2>
      <p class="section-lede">
        Each of these covers one requirement in depth — what it is, why it matters here, and what is
        worth doing about it.
      </p>
      <div class="guide-grid">
        {MN_CODE_GUIDES.map((g) => (
          <a href={`/guides/minnesota/${g.slug}`} class="guide-card">
            <span class="badge">{g.system}</span>
            <h3>{g.title}</h3>
            <p>{g.summary}</p>
            <span class="guide-year">{g.yearCondition}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="faq">
    <div class="wrap">
      <h2>Common questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="mn-cities">
    <div class="wrap">
      <h2>Run this against a specific address</h2>
      <p>
        Tarn checks every factor above automatically when you search an address with a year built in
        any of these Minnesota cities.
      </p>
      <ul class="city-chips">
        {MN_GUIDE_CITIES.map((c) => (
          <li><a href={`/cities/${c.slug}`}>{c.name}</a></li>
        ))}
      </ul>
      <a href="/" class="btn btn-primary">Search an address</a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .mn-hero {
    padding: 3.5rem 0 3rem;
    background: var(--charter-navy);
    color: var(--cream);
  }
  .mn-hero .eyebrow {
    color: var(--glacial-teal);
  }
  .mn-hero h1 {
    color: var(--cream);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    max-width: 820px;
  }
  .hero-lede {
    max-width: 700px;
    opacity: 0.9;
    font-size: 1.05rem;
  }
  .hero-byline {
    font-size: 0.85rem;
    opacity: 0.75;
    margin-top: 1.5rem;
  }

  .mn-intro {
    padding: 2.25rem 0 0;
  }
  .mn-intro p {
    max-width: 760px;
    color: var(--slate);
    margin: 0;
  }

  .timeline {
    padding: 2.5rem 0 1rem;
  }
  .system-block {
    margin-bottom: 2.5rem;
  }
  .system-block h2 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }
  .timeline-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
  }
  .timeline-table th {
    text-align: left;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--slate);
    border-bottom: 1px solid var(--border);
    padding: 0 0.75rem 0.5rem 0;
  }
  .timeline-table td {
    border-bottom: 1px solid var(--border);
    padding: 0.7rem 0.75rem 0.7rem 0;
    vertical-align: top;
    color: var(--ink);
  }
  .timeline-table td a {
    color: var(--charter-navy);
    font-weight: 600;
    text-decoration: none;
  }
  .timeline-table td a:hover {
    text-decoration: underline;
  }
  .tag {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--slate);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1rem 0.35rem;
    white-space: nowrap;
  }

  .mn-guides {
    background: var(--cream);
    border-top: 1px solid var(--border);
    padding: 3rem 0;
  }
  .mn-guides h2 {
    font-size: 1.15rem;
  }
  .section-lede {
    color: var(--slate);
    max-width: 600px;
    margin: 0.4rem 0 1.5rem;
  }
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1rem;
  }
  .guide-card {
    display: block;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.35rem;
    text-decoration: none;
    color: inherit;
  }
  .guide-card:hover {
    border-color: var(--charter-navy);
  }
  .guide-card h3 {
    font-size: 1rem;
    margin: 0.6rem 0 0.4rem;
    color: var(--charter-navy);
  }
  .guide-card p {
    font-size: 0.9rem;
    color: var(--slate);
    margin: 0 0 0.75rem;
    line-height: 1.55;
  }
  .badge {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
    color: var(--glacial-teal);
  }
  .guide-year {
    font-size: 0.8rem;
    color: var(--slate);
  }

  .faq {
    padding: 3rem 0;
  }
  .faq h2 {
    font-size: 1.15rem;
  }
  .faq-list {
    margin-top: 1rem;
    max-width: 780px;
  }
  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 0.9rem 0;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--charter-navy);
    list-style: none;
    position: relative;
    padding-right: 1.5rem;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    color: var(--slate);
  }
  .faq-item[open] summary::after {
    content: '\2212';
  }
  .faq-item p {
    color: var(--slate);
    margin: 0.7rem 0 0;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .mn-cities {
    background: var(--cream);
    border-top: 1px solid var(--border);
    padding: 3rem 0;
  }
  .mn-cities h2 {
    font-size: 1.15rem;
  }
  .mn-cities p {
    color: var(--slate);
    max-width: 560px;
    margin: 0.4rem 0 0;
  }
  .city-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.25rem 0 1.75rem;
  }
  .city-chips a {
    display: inline-block;
    padding: 0.38rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--white);
    color: var(--charter-navy);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .city-chips a:hover {
    border-color: var(--charter-navy);
  }

  @media (max-width: 700px) {
    .timeline-table thead {
      display: none;
    }
    .timeline-table,
    .timeline-table tbody,
    .timeline-table tr,
    .timeline-table td {
      display: block;
      width: 100%;
    }
    .timeline-table tr {
      border-bottom: 1px solid var(--border);
      padding: 0.85rem 0;
    }
    .timeline-table td {
      border: none;
      padding: 0.1rem 0;
    }
    .timeline-table td:not(:first-child) {
      font-size: 0.85rem;
      color: var(--slate);
    }
  }
</style>
