---
// Server-rendered results page. Not prerendered — runs per-request so it can
// read the city/number/street query params and fetch permit + environmental
// data live. Currently has a native (in-Worker) flow for Minnetonka, MN,
// Los Angeles, CA, New York, NY, San Francisco, CA, Minneapolis, MN,
// Chicago, IL, Seattle, WA, Philadelphia, PA, Dallas, TX, Austin, TX,
// Kansas City, MO, New Orleans, LA, Pittsburgh, PA, Baltimore, MD, Milwaukee, WI, Cincinnati, OH, Nashville, TN, Cleveland, OH, Denver, CO, and Detroit, MI; every other launch city still bridges to the existing Streamlit app while that
// city's data source gets ported over one at a time.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { env } from 'cloudflare:workers';
import { getMinnetonkaData } from '../lib/minnetonka';
import { getLosAngelesData } from '../lib/los-angeles';
import { getNycData, getNycViolations, type NycViolation } from '../lib/new-york';
import { getSanFranciscoData } from '../lib/san-francisco';
import { getMinneapolisData } from '../lib/minneapolis';
import { getChicagoData } from '../lib/chicago';
import { getSeattleData } from '../lib/seattle';
import { getPhiladelphiaData } from '../lib/philadelphia';
import { getDallasData } from '../lib/dallas';
import { getAustinData } from '../lib/austin';
import { getKansasCityData } from '../lib/kansas-city';
import { getNewOrleansData } from '../lib/new-orleans';
import { getPittsburghData } from '../lib/pittsburgh';
import { getBaltimoreData } from '../lib/baltimore';
import { getMilwaukeeData } from '../lib/milwaukee';
import { getCincinnatiData } from '../lib/cincinnati';
import { getNashvilleData } from '../lib/nashville';
import { getClevelandData } from '../lib/cleveland';
import { getDenverData } from '../lib/denver';
import { getDetroitData } from '../lib/detroit';
import { analyzeHistory } from '../lib/risk-engine';
import {
  getGeocode,
  getFemaFloodZone,
  getUsgsSeismicZone,
  getRadonZone,
  RADON_ZONE_LABELS,
} from '../lib/environmental';

const APP_URL = 'https://app.tarnhome.com';

const city = (Astro.url.searchParams.get('city') || '').trim();
const number = (Astro.url.searchParams.get('number') || '').trim();
const street = (Astro.url.searchParams.get('street') || '').trim();
const yearBuiltRaw = (Astro.url.searchParams.get('yearBuilt') || '').trim();
const yearBuilt = /^\d{4}$/.test(yearBuiltRaw) ? parseInt(yearBuiltRaw, 10) : null;

const NATIVE_CITIES = new Set(['Minnetonka, MN', 'Los Angeles, CA', 'New York, NY', 'San Francisco, CA', 'Minneapolis, MN', 'Chicago, IL', 'Seattle, WA', 'Philadelphia, PA', 'Dallas, TX', 'Austin, TX', 'Kansas City, MO', 'New Orleans, LA', 'Pittsburgh, PA', 'Baltimore, MD', 'Milwaukee, WI', 'Cincinnati, OH', 'Nashville, TN', 'Cleveland, OH', 'Denver, CO', 'Detroit, MI']);
const isNative = NATIVE_CITIES.has(city);
const hasQuery = Boolean(city && number && street);

const bridgeUrl =
  APP_URL +
  '?' +
  new URLSearchParams({ city, number, street }).toString();

let permits: Awaited<ReturnType<typeof getMinnetonkaData>> = [];
let score = 0;
let findings: { cat: string; msg: string; type: string }[] = [];
let flood: Awaited<ReturnType<typeof getFemaFloodZone>> = null;
let seismic: string | null = null;
let radonZone: number | null = null;
let fullAddress = '';
let fetchError = false;
let nycViolations: NycViolation[] = [];

if (isNative && hasQuery) {
  try {
    if (city === 'Los Angeles, CA') {
      permits = await getLosAngelesData(number, street);
    } else if (city === 'New York, NY') {
      permits = await getNycData(number, street);
      nycViolations = await getNycViolations(number, street);
    } else if (city === 'San Francisco, CA') {
      permits = await getSanFranciscoData(number, street);
    } else if (city === 'Minneapolis, MN') {
      permits = await getMinneapolisData(number, street);
    } else if (city === 'Chicago, IL') {
      permits = await getChicagoData(number, street);
    } else if (city === 'Seattle, WA') {
      permits = await getSeattleData(number, street);
    } else if (city === 'Philadelphia, PA') {
      permits = await getPhiladelphiaData(number, street);
    } else if (city === 'Dallas, TX') {
      permits = await getDallasData(number, street);
    } else if (city === 'Austin, TX') {
      permits = await getAustinData(number, street);
    } else if (city === 'Kansas City, MO') {
      permits = await getKansasCityData(number, street);
    } else if (city === 'New Orleans, LA') {
      permits = await getNewOrleansData(number, street);
    } else if (city === 'Pittsburgh, PA') {
      permits = await getPittsburghData(number, street);
    } else if (city === 'Baltimore, MD') {
      permits = await getBaltimoreData(number, street);
    } else if (city === 'Milwaukee, WI') {
      permits = await getMilwaukeeData(number, street);
    } else if (city === 'Cincinnati, OH') {
      permits = await getCincinnatiData(number, street);
    } else if (city === 'Nashville, TN') {
      permits = await getNashvilleData(number, street);
    } else if (city === 'Cleveland, OH') {
      permits = await getClevelandData(number, street);
    } else if (city === 'Denver, CO') {
      permits = await getDenverData(number, street);
    } else if (city === 'Detroit, MI') {
      permits = await getDetroitData(number, street);
    } else {
      const assetsBinding = (env as any)?.ASSETS;
      const assetsFetch = assetsBinding ? assetsBinding.fetch.bind(assetsBinding) : undefined;
      permits = await getMinnetonkaData(number, street, Astro.url.origin, assetsFetch);
    }
    const analysis = analyzeHistory(permits, city, yearBuilt);
    score = analysis.score;
    findings = analysis.findings;

    fullAddress = `${number} ${street}, ${city}`;
    const geo = await getGeocode(fullAddress);
    if (geo.lat && geo.lon) {
      flood = await getFemaFloodZone(geo.lat, geo.lon);
      seismic = await getUsgsSeismicZone(geo.lat, geo.lon);
    }
    radonZone = getRadonZone(geo.countyFips);
  } catch (e) {
    fetchError = true;
  }
}

const sortedFindings = [...findings].sort((a: any, b: any) => (b.d || 0) - (a.d || 0));
const nycHigh = nycViolations.filter((v) => v.severity === 'HIGH');
const nycMedium = nycViolations.filter((v) => v.severity === 'MEDIUM');
const nycLow = nycViolations.filter((v) => v.severity === 'LOW');

function catLabel(cat: string) {
  return cat.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}
---

<Layout
  title={hasQuery ? `${number} ${street}, ${city} — Tarn Report` : 'Search results'}
  description="Permit history, code-era risk, and environmental context for this address."
>
  <Header slot="header" />

  <section class="results-hero">
    <div class="wrap">
      {hasQuery ? (
        <>
          <p class="eyebrow">{city}</p>
          <h1>{number} {street}</h1>
        </>
      ) : (
        <h1>Search for an address</h1>
      )}
    </div>
  </section>

  <section class="results-body">
    <div class="wrap">
      {!hasQuery && (
        <p>No address was provided. <a href="/">Go back and search</a>.</p>
      )}

      {hasQuery && !isNative && (
        <div class="bridge-card">
          <p class="eyebrow">One moment</p>
          <h2>{city} runs on our classic tool for now</h2>
          <p>
            We're porting each city's report over to the new Tarn site one at a time.
            {city} isn't ready here yet, so we'll take you to the existing report for
            this address instead — same data, different wrapper.
          </p>
          <a href={bridgeUrl} class="btn btn-primary">Continue to {city} report</a>
        </div>
      )}

      {hasQuery && isNative && fetchError && (
        <div class="bridge-card">
          <p class="eyebrow">Something went wrong</p>
          <h2>Couldn't load this report</h2>
          <p>Try again in a moment, or search a different address.</p>
        </div>
      )}

      {hasQuery && isNative && !fetchError && (
        <>
          <div class="metric-row">
            <div class="score-card">
              <div class="metric-label">Items to investigate</div>
              <div class="metric-value">{findings.length}</div>
            </div>
            <div class="score-card">
              <div class="metric-label">Year built</div>
              <div class="metric-value">{yearBuilt ?? '—'}</div>
            </div>
            <div class="score-card">
              <div class="metric-label">Permits found</div>
              <div class="metric-value">{permits.length}</div>
            </div>
          </div>
          <p class="disclaimer">
            <strong>For informational purposes only.</strong> This report surfaces public
            permit records that may be worth a closer look. It is not a home inspection,
            appraisal, or professional opinion. Always consult a licensed inspector before
            any real estate decision. Permit records may be incomplete or delayed.
          </p>

          <h2 class="section-title">Permit forensic log</h2>
          <p class="section-sub">Free · Sourced from public government permit records</p>
          {findings.length === 0 ? (
            <div class="info-box">
              No specific items flagged based on permit records and year built. This does
              not mean no issues exist — unpermitted work will not appear here. A licensed
              home inspector can identify issues permit records won't show.
            </div>
          ) : (
            <div class="findings-list">
              {sortedFindings.map((f: any) => (
                <div class="finding">
                  <strong>{catLabel(f.cat)}</strong>
                  <span>{f.msg}</span>
                </div>
              ))}
            </div>
          )}

          {city === 'New York, NY' && (
            <>
              <h2 class="section-title">NYC DOB violation history</h2>
              {nycViolations.length === 0 ? (
                <div class="info-box">
                  No DOB violations found in public records for this address. This does
                  not guarantee no issues exist — always verify directly with NYC DOB.
                </div>
              ) : (
                <>
                  <p class="section-sub">
                    {nycViolations.length} violation record{nycViolations.length !== 1 ? 's' : ''} found.
                    Sources: DOB Violations (BIS) + DOB Safety Violations (DOB NOW). Updated daily via NYC Open Data.
                  </p>
                  <div class="metric-row">
                    <div class="score-card">
                      <div class="metric-label">Worth investigating</div>
                      <div class="metric-value">{nycHigh.length}</div>
                    </div>
                    <div class="score-card">
                      <div class="metric-label">May warrant review</div>
                      <div class="metric-value">{nycMedium.length}</div>
                    </div>
                    <div class="score-card">
                      <div class="metric-label">Informational</div>
                      <div class="metric-value">{nycLow.length}</div>
                    </div>
                  </div>
                  {nycHigh.length > 0 && (
                    <div class="findings-list">
                      {nycHigh.map((v) => (
                        <div class="violation violation-high">
                          <strong>{v.date} &bull; {v.type}</strong>
                          <span>{v.desc.slice(0, 200)}</span>
                          <span class="violation-meta">Status: {v.status} | {v.source}</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {nycMedium.length > 0 && (
                    <div class="findings-list">
                      {nycMedium.map((v) => (
                        <div class="violation violation-medium">
                          <strong>{v.date} &bull; {v.type}</strong>
                          <span>{v.desc.slice(0, 200)}</span>
                          <span class="violation-meta">Status: {v.status} | {v.source}</span>
                        </div>
                      ))}
                    </div>
                  )}
                  {nycLow.length > 0 && (
                    <details class="raw-data">
                      <summary>Low severity violations ({nycLow.length})</summary>
                      <div class="findings-list">
                        {nycLow.map((v) => (
                          <div class="violation violation-low">
                            <strong>{v.date} &bull; {v.type}</strong>
                            <span>{v.desc.slice(0, 160)}</span>
                            <span class="violation-meta">{v.status} | {v.source}</span>
                          </div>
                        ))}
                      </div>
                    </details>
                  )}
                </>
              )}
            </>
          )}

          <h2 class="section-title">Environmental &amp; hazard context</h2>
          <p class="section-sub">
            Sources: FEMA National Flood Hazard Layer · EPA Radon Zone Map · USGS Seismic
            Design Data. All US federal public domain.
          </p>
          <div class="env-row">
            <div class="env-card">
              <strong>Flood zone (FEMA NFHL)</strong>
              {flood ? (
                <div class={`env-pill ${['AE','A','AO','AH','VE','V'].includes(flood.zone) ? 'high' : 'low'}`}>
                  <span class="env-pill-title">Zone {flood.zone}</span>
                  <span>{flood.description}</span>
                  {flood.sfha && <span><strong>SFHA — flood insurance required for federally backed mortgages</strong></span>}
                </div>
              ) : (
                <div class="env-pill neutral">Flood zone lookup unavailable for this address.</div>
              )}
            </div>
            <div class="env-card">
              <strong>Radon risk (EPA)</strong>
              {radonZone ? (
                <div class={`env-pill ${RADON_ZONE_LABELS[radonZone].label === 'HIGH' ? 'high' : RADON_ZONE_LABELS[radonZone].label === 'MEDIUM' ? 'mid' : 'low'}`}>
                  <span class="env-pill-title">{RADON_ZONE_LABELS[radonZone].label} — Zone {radonZone}</span>
                  <span>{RADON_ZONE_LABELS[radonZone].desc}</span>
                  <span>Test cost: $15–$25 DIY · Mitigation: $800–$2,500</span>
                </div>
              ) : (
                <div class="env-pill neutral">County not resolved — radon zone unavailable.</div>
              )}
            </div>
            <div class="env-card">
              <strong>Seismic zone (USGS)</strong>
              {seismic ? (
                <div class={`env-pill ${['C','D','E','F'].includes(seismic) ? 'high' : 'low'}`}>
                  <span class="env-pill-title">SDC {seismic}</span>
                </div>
              ) : (
                <div class="env-pill neutral">Seismic data unavailable.</div>
              )}
            </div>
          </div>

          <details class="raw-data">
            <summary>Raw permit data ({permits.length})</summary>
            <div class="raw-table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Permit #</th>
                  </tr>
                </thead>
                <tbody>
                  {permits.map((p) => (
                    <tr>
                      <td>{p.permit_creation_date}</td>
                      <td>{p.permit_type}</td>
                      <td>{p.description}</td>
                      <td>{p.permit_number}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        </>
      )}
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .results-hero {
    padding: 3rem 0 2rem;
    background: linear-gradient(180deg, var(--charter-navy) 0%, #142a4d 100%);
    color: var(--cream);
  }
  .results-hero h1 {
    color: var(--cream);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
  }
  .results-body {
    padding: 2.5rem 0 4rem;
  }
  .bridge-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 2rem;
    max-width: 620px;
  }
  .metric-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .score-card {
    padding: 1.25rem;
    border-radius: 10px;
    background: var(--white);
    border: 1px solid var(--border);
    text-align: center;
  }
  .metric-label {
    font-size: 0.8rem;
    color: var(--slate);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .metric-value {
    font-size: 2rem;
    font-weight: 800;
    color: var(--charter-navy);
    font-family: var(--font-serif);
  }
  .disclaimer {
    font-size: 0.9rem;
    color: var(--slate);
    max-width: 720px;
  }
  .section-title {
    margin-top: 2.5rem;
  }
  .section-sub {
    color: var(--slate);
    font-size: 0.9rem;
    margin-top: -0.5em;
  }
  .info-box {
    background: var(--white);
    border: 1px solid var(--border);
    border-left: 3px solid var(--warm-amber);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    color: var(--slate);
  }
  .findings-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .finding {
    background: var(--white);
    border-left: 3px solid #94a3b8;
    border-radius: 4px;
    padding: 0.7rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .finding span {
    font-size: 0.92rem;
    color: #374151;
  }
  .violation {
    border-radius: 4px;
    padding: 0.7rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .violation strong {
    font-size: 0.95rem;
  }
  .violation span {
    font-size: 0.9rem;
  }
  .violation-meta {
    color: #6b7280;
    font-size: 0.8rem;
  }
  .violation-high {
    background: #fee2e2;
    border-left: 3px solid #dc2626;
  }
  .violation-medium {
    background: #fffbeb;
    border-left: 3px solid #d97706;
  }
  .violation-low {
    background: var(--white);
    border-left: 3px solid #94a3b8;
  }
  .env-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .env-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .env-pill {
    padding: 0.75rem;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.88rem;
  }
  .env-pill-title {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .env-pill.high { background: #fee2e2; color: #991b1b; }
  .env-pill.mid { background: #fffbeb; color: #92400e; }
  .env-pill.low { background: #d1fae5; color: #065f46; }
  .env-pill.neutral { background: var(--white); border: 1px solid var(--border); color: var(--slate); }
  .raw-data {
    margin-top: 2.5rem;
  }
  .raw-data summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.75rem 0;
  }
  .raw-table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
    font-size: 0.85rem;
  }
  th, td {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  th {
    background: var(--cream);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--slate);
  }
  @media (max-width: 700px) {
    .metric-row, .env-row {
      grid-template-columns: 1fr;
    }
  }
</style>
