---
export const prerender = true;
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((city) => ({
    params: { slug: city.data.slug },
    props: { city },
  }));
}

interface Props {
  city: CollectionEntry<'cities'>;
}

const { city } = Astro.props as Props;
const d = city.data;
const APP_URL = "https://app.tarnhome.com";

const title = `${d.city}, ${d.state} Permit History & Home Risk Data`;
const description = `${d.summary} Search any ${d.city}, ${d.state} address on Tarn for permit history, code-era risk flags, and cost-of-ownership estimates.`;

function summarizeCoverage(coverage: { type: string; since: string }[]): string {
  const bySince = new Map<string, string[]>();
  for (const c of coverage) {
    if (!bySince.has(c.since)) bySince.set(c.since, []);
    bySince.get(c.since)!.push(c.type);
  }
  const parts: string[] = [];
  for (const [since, types] of bySince) {
    const typesJoined =
      types.length === 1
        ? types[0]
        : types.length === 2
          ? `${types[0]} and ${types[1]}`
          : `${types.slice(0, -1).join(', ')}, and ${types[types.length - 1]}`;
    const sincePhrase = /^\d/.test(since) ? `since ${since}` : since;
    parts.push(`${typesJoined} (${sincePhrase})`);
  }
  return parts.join('; ');
}

const faqs: { q: string; a: string }[] = [
  {
    q: `How deep is ${d.city}, ${d.state} permit data on Tarn?`,
    a: d.summary,
  },
  {
    q: `Where does Tarn's ${d.city} permit data come from?`,
    a: `Tarn's ${d.city} permit data comes from ${d.dataSource}.${d.permitCount ? ` As of the last update, that's ${d.permitCount.toLocaleString()} permits on record.` : ''}`,
  },
  {
    q: `How far back does Tarn's ${d.city} coverage go?`,
    a: `Coverage varies by system in ${d.city}: ${summarizeCoverage(d.coverage)}.`,
  },
  {
    q: `Does Tarn check code-era risks like lead paint or old wiring in ${d.city}?`,
    a: `Yes. When you search a ${d.city} address and enter the year it was built, Tarn checks it against national code-era risk factors — lead paint, electrical panel age and wiring type, plumbing material, and more.${d.appCityKey === 'Minneapolis, MN' ? ` Minneapolis reports also run Tarn's Minnesota Code Timeline, a set of Minnesota-specific safety-gap checks covering electrical, structural, plumbing, roofing, and HVAC systems, drawn from MN Rule 1309 and 4714.` : ''}`,
  },
  {
    q: `Is Tarn free to use in ${d.city}?`,
    a: `Yes — Tarn is free while we're building it. In exchange, we ask what wasn't useful.`,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a,
    },
  })),
};
---

<Layout title={title} description={description}>
  <Header slot="header" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="city-hero">
    <div class="wrap">
      <p class="eyebrow">{d.dataDepth === 'deep' ? 'Deep coverage' : 'Standard coverage'} · {d.metroArea}</p>
      <h1>{d.city}, {d.state} permit history &amp; home risk data</h1>
      <p class="city-summary">{d.summary}</p>
      <form class="search-form" action="/results" method="get">
        <input type="hidden" name="city" value={d.appCityKey} />
        <label for="number" class="sr-only">Street number</label>
        <input id="number" name="number" type="text" placeholder="Street #" autocomplete="off" />
        <label for="street" class="sr-only">Street name in {d.city}</label>
        <input id="street" name="street" type="text" placeholder={`Street name in ${d.city}`} autocomplete="off" />
        <label for="yearBuilt" class="sr-only">Year built (optional)</label>
        <input
          id="yearBuilt"
          name="yearBuilt"
          type="text"
          inputmode="numeric"
          pattern="[0-9]{4}"
          maxlength="4"
          placeholder="Year built"
          autocomplete="off"
          class="year-built-input"
        />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
      <p class="year-built-note">
        Year built is optional, but it's what unlocks the code-era risk exam for {d.city} addresses.
      </p>
    </div>
  </section>

  <section class="coverage">
    <div class="wrap">
      <h2>What Tarn covers in {d.city}</h2>
      <p class="source-line">Source: {d.dataSource}{d.permitCount ? ` — ${d.permitCount.toLocaleString()} permits on record.` : ''}</p>
      <table class="coverage-table">
        <thead>
          <tr>
            <th>System</th>
            <th>Records since</th>
          </tr>
        </thead>
        <tbody>
          {d.coverage.map((c) => (
            <tr>
              <td>{c.type}</td>
              <td>{c.since}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {d.notes && d.notes.length > 0 && (
        <ul class="notes-list">
          {d.notes.map((n: string) => <li>{n}</li>)}
        </ul>
      )}
    </div>
  </section>

  <section class="faq">
    <div class="wrap">
      <h2>{d.city} frequently asked questions</h2>
      <ul class="faq-list">
        {faqs.map((f) => (
          <li class="faq-item">
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="city-cta">
    <div class="wrap city-cta-inner">
      <div>
        <h2>Look up a specific {d.city} address</h2>
        <p>Free while we're building. Tell us what's missing and you keep full access.</p>
      </div>
      <a href={`/results?city=${encodeURIComponent(d.appCityKey)}`} class="btn btn-primary">Search {d.city} addresses</a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .city-hero {
    padding: 3.5rem 0 3rem;
    background: var(--charter-navy);
    color: var(--cream);
  }
  .city-hero h1 {
    color: var(--cream);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    max-width: 780px;
  }
  .city-summary {
    max-width: 620px;
    opacity: 0.9;
    font-size: 1.05rem;
  }
  .search-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
    max-width: 620px;
  }
  .search-form input[type="text"] {
    flex: 1;
    min-width: 110px;
    padding: 0.8rem 1rem;
    border-radius: 4px;
    border: none;
    font-size: 1rem;
  }
  .search-form .year-built-input {
    flex: 0 1 130px;
  }
  .year-built-note {
    margin-top: 0.6rem;
    max-width: 520px;
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .coverage {
    padding: 3.5rem 0;
  }
  .source-line {
    color: var(--slate);
    font-size: 0.95rem;
  }
  .coverage-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
    background: var(--white);
    border: 1px solid var(--border);
  }
  .coverage-table th,
  .coverage-table td {
    text-align: left;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--border);
  }
  .coverage-table th {
    background: var(--cream);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--slate);
  }
  .notes-list {
    margin-top: 1.5rem;
    color: var(--slate);
  }

  .faq {
    padding: 3.5rem 0;
    background: var(--cream);
    border-top: 1px solid var(--border);
  }
  .faq-list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-item {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .faq-item summary {
    cursor: pointer;
    list-style: none;
    padding: 1.1rem 3rem 1.1rem 1.25rem;
    font-weight: 600;
    position: relative;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: "+";
    position: absolute;
    right: 1.25rem;
    top: 1.1rem;
    font-weight: 400;
    color: var(--slate);
  }
  .faq-item details[open] summary::after {
    content: "\2212";
  }
  .faq-item p {
    margin: 0;
    padding: 0 1.25rem 1.1rem;
    color: var(--slate);
  }

  .city-cta {
    background: var(--white);
    border-top: 1px solid var(--border);
    padding: 3rem 0;
  }
  .city-cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .city-cta-inner p {
    color: var(--slate);
    margin: 0;
  }
  @media (max-width: 640px) {
    .search-form {
      flex-direction: column;
    }
  }
</style>
